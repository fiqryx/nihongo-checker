# Optional defaults. You can also set these in the Settings panel in the UI
# (the UI values win over these).
#
# 9router usually exposes an OpenAI-compatible base URL like http://localhost:20128/v1
LLM_BASE_URL=http://localhost:20128/v1
LLM_MODEL=your-model-name
# Leave empty if your endpoint does not need a key.
LLM_API_KEY=
